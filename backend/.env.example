# Variables de entorno del backend.
#
# Copiar como .env (está en .gitignore) y completar. En producción se
# configuran en el panel de Render, no en un archivo.
#
# NUNCA committear el .env real: contiene credenciales.

# ── Base de datos ────────────────────────────────────────────────────
# En Render se define DATABASE_URL y se ignora lo demás.
DATABASE_URL=
# Alternativa para desarrollo local (si no se usa DATABASE_URL):
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=iniciativa_baby

# ── Servidor ─────────────────────────────────────────────────────────
PORT=3000

# URL pública del frontend. Se usa para armar los enlaces de los correos
# (por ejemplo, el de aceptar una invitación). Si no se define, se usa
# https://babycaree-web.vercel.app
APP_URL=

# Orígenes extra permitidos por CORS, separados por coma. Útil para las
# URLs de preview de Vercel. El dominio de producción y localhost:5173
# ya están permitidos por defecto.
CORS_EXTRA_ORIGINS=

# ── Seguridad ────────────────────────────────────────────────────────
JWT_SECRET=
JWT_ADMIN_SECRET=
JWT_RECOVERY_SECRET=
# Clave para cifrar datos sensibles en la base de datos (hex).
ENCRYPTION_KEY=

# ── Correo (Brevo) ───────────────────────────────────────────────────
BREVO_API_KEY=
SMTP_FROM_EMAIL=

# ── Notificaciones push (VAPID) ──────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ── Login con Google ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=

# ── Sembrado inicial del admin (solo scripts) ────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
