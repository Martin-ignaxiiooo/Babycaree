{
  "expo": {
    "name": "Baby Care",
    "slug": "baby-care",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "babycare",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.babycare.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Baby Care usa el micrófono para que puedas dictar los datos de una hora médica en vez de escribirlos. El audio se procesa para completar el formulario y no se guarda."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F2E5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.babycare.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F2E5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-asset",
      [
        "expo-audio",
        {
          "microphonePermission": "Baby Care usa el micrófono para que puedas dictar los datos de una hora médica."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    }
  }
}
