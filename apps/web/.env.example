# Variables de entorno del frontend (Vite).
#
# Copiar este archivo como .env.local (que está en .gitignore) y ajustar
# los valores. Todas son OPCIONALES: si no se definen, se usan los
# valores de producción por defecto y la app funciona igual.

# URL base del backend, incluyendo /api.
# Producción (valor por defecto si no se define):
#   VITE_API_URL=https://babycare-backend-msyq.onrender.com/api
# Para desarrollo contra un backend local:
#   VITE_API_URL=http://localhost:3000/api
VITE_API_URL=https://babycare-backend-msyq.onrender.com/api
